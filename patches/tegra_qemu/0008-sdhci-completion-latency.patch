+        qdev_prop_set_uint32(tmpdev, "data-ns-per-kib", 4000);
+    } else if (index == 0) {
+        qdev_prop_set_uint32(tmpdev, "cmd-latency-ns", 100000);
+        qdev_prop_set_uint32(tmpdev, "data-ns-per-kib", 40000);
+    }
     sysbus_realize_and_unref(SYS_BUS_DEVICE(tmpdev), &error_fatal);
 
