diff --git a/include/hw/sd/sdhci.h b/include/hw/sd/sdhci.h
index 8a9cced..d3c46eb 100644
--- a/include/hw/sd/sdhci.h
+++ b/include/hw/sd/sdhci.h
@@ -51,6 +51,15 @@ struct SDHCIState {
     QEMUTimer *transfer_timer;
     qemu_irq irq;
 
+    /* Optional completion latency (virtual time): command complete after cmd_latency_ns, transfer complete after
+     * the data at data_ns_per_kib more, with CMD/DATA inhibit held until then. 0/0 completes at once. */
+    uint32_t cmd_latency_ns;
+    uint32_t data_ns_per_kib;
+    QEMUTimer *latency_timer;
+    uint16_t pending_cmd_nis, pending_xfer_nis;
+    uint32_t pending_prnsts_clear;
+    int64_t cmd_deadline, xfer_deadline;
+
     /* Registers cleared on reset */
     uint32_t sdmasysad;    /* SDMA System Address register */
     uint16_t blksize;      /* Host DMA Buff Boundary and Transfer BlkSize Reg */
diff --git a/hw/arm/tegra2/tegrax1.c b/hw/arm/tegra2/tegrax1.c
index bf96015..7b11918 100644
--- a/hw/arm/tegra2/tegrax1.c
