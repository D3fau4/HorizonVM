                      dma_dev, 0),
+    DEFINE_PROP_UINT32("cmd-latency-ns", SDHCIState, cmd_latency_ns, 0),
+    DEFINE_PROP_UINT32("data-ns-per-kib", SDHCIState, data_ns_per_kib, 0),
