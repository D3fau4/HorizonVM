     qdev_prop_set_uint32(tmpdev, "dma_dev", TegraIommuDeviceName_Sdmmc1a + index);
+    // Command/transfer completion takes time, as on the real cards (drivers sleep on the interrupt meanwhile):
+    // eMMC ~250 MB/s (HS400), SD ~25 MB/s (high speed; no UHS at 3.3 V).
+    if (emmc) {
