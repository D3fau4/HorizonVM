Hide SE/FEK key hexdumps behind TEGRA_DEBUG_SECRETS (stdout at reset and every -d/-D log).

diff --git a/hw/arm/tegra2/apb/se/se.c b/hw/arm/tegra2/apb/se/se.c
index c7eb8bf..dffe515 100644
--- a/hw/arm/tegra2/apb/se/se.c
+++ b/hw/arm/tegra2/apb/se/se.c
@@ -192,11 +192,13 @@ static const VMStateDescription vmstate_tegra_se = {
 static void se_log_hexdump(const char *prefix,
                            const void *bufptr, size_t size)
 {
+#ifdef TEGRA_DEBUG_SECRETS /* Dumps key material: never enable with real keys. */
     FILE *f = qemu_log_trylock();
     if (f) {
         qemu_hexdump(f, prefix, bufptr, size);
         qemu_log_unlock(f);
     }
+#endif
 }
 
 // RSA code is copied from / based on akcipher-gcrypt.c.inc. The crypto/ code requires using DER keys, which we want to avoid.
@@ -1534,7 +1536,9 @@ static void tegra_se_priv_reset(DeviceState *dev)
             else {
                 keylen = MIN(datalen, 0x20);
                 memcpy(&s->aes_keytable[keyslot*0x10], data, keylen);
+#ifdef TEGRA_DEBUG_SECRETS
                 qemu_hexdump(stdout, tmpstr, &s->aes_keytable[keyslot*0x10], keylen);
+#endif
                 if (datalen==0x40) {
                     s->aes_dataoverride_enable[keyslot] = 1;
                     memcpy(&s->aes_dataoverride[keyslot*0x8], &data[0x20], 0x20);
diff --git a/hw/arm/tegra2/ppsb/apb_misc/apb_misc.c b/hw/arm/tegra2/ppsb/apb_misc/apb_misc.c
index 6e0140a..d714e18 100644
--- a/hw/arm/tegra2/ppsb/apb_misc/apb_misc.c
+++ b/hw/arm/tegra2/ppsb/apb_misc/apb_misc.c
@@ -1204,7 +1204,9 @@ static void tegra_apb_misc_priv_reset(DeviceState *dev)
                 if (datalen!=0x10) error_setg(&err, "SE: Invalid datalen for secret %s, datalen=0x%zx expected 0x%x.", tmpstr, datalen, 0x10);
                 else {
                     memcpy(keyptr, data, 0x10);
+#ifdef TEGRA_DEBUG_SECRETS
                     qemu_hexdump(stdout, tmpstr, keyptr, 0x10);
+#endif
                 }
                 g_free(data);
             }
